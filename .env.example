# Copy to .env and fill in what you want. Everything is optional; the app runs with none of these.
EDGEDESK_PASSWORD=          # set to let other devices on your network open the app (user name: edgedesk)
ANTHROPIC_API_KEY=          # optional: Claude review of the picks
ODDS_API_KEY=               # optional: the-odds-api.com feed
EDGEDESK_FANDUEL_STATE=az   # which regional copy of FanDuel's public feed to read
EDGEDESK_APIFY=             # set to 1 (with APIFY_TOKEN) to buy DraftKings / PrizePicks / Underdog props
APIFY_TOKEN=
